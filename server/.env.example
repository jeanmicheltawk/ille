# Required — PostgreSQL connection string
DATABASE_URL=postgresql://ille:ille@localhost:5432/ille
NODE_ENV=development

PORT=3000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@ille.co
ADMIN_PASSWORD=illeadmin

# Email / newsletter (optional — subscribers are stored even without SMTP)
SITE_URL=https://ille.co
NEWSLETTER_FROM=bookings@ille.co
BOOKINGS_NOTIFY_EMAIL=bookings@ille.co
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=bookings@ille.co
SMTP_PASS=your-smtp-password

# info@ille.co — service forms + new-model subscriber notices
INFO_FROM=info@ille.co
INFO_NOTIFY_EMAIL=info@ille.co
INFO_SMTP_USER=info@ille.co
INFO_SMTP_PASS=your-info-smtp-password
